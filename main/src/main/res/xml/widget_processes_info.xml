<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is deliberately left unset: the floor is 30 minutes and Android 12+ ignores it
  for most launchers anyway. Refreshes are driven by WidgetUpdateService instead.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/ic_widget_preview_procs"
    android:description="@string/widget_procs_desc"
    android:initialLayout="@layout/glance_default_loading_layout" />